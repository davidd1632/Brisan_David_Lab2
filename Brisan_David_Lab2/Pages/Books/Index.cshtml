@page "/"
@model Brisan_David_Lab2.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Books";
}

<h1>Books</h1>

<p>
    <a asp-page="Create" class="btn btn-success">Create New</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Book Title</th>
            <th>Author</th>
            <th>Price</th>
            <th>Publishing Date</th>
            <th>Publisher Name</th>
            <th>Categories</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.BookD.Books)
        {
            string selectedRow = "";
            if (item.ID == Model.BookID)
            {
                selectedRow = "table-success";
            }

            <tr class="@selectedRow">
                <td>@Html.DisplayFor(modelItem => item.Title)</td>

           
                <td>
                    @if (item.Author != null)
                    {
                        @item.Author.LastName
                        @: @item.Author.FirstName
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </td>

                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.PublishingDate)</td>

                <td>
                    @if (item.Publisher != null)
                    {
                        @item.Publisher.PublisherName
                    }
                </td>

                <td>
                    @if (item.BookCategories != null && item.BookCategories.Any())
                    {
                        foreach (var cat in item.BookCategories)
                        {
                            <span class="badge bg-secondary">@cat.Category.CategoryName</span> <br />
                        }
                    }
                    else
                    {
                        <span class="text-muted">None</span>
                    }
                </td>

                <td>
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>