@page
@model Brisan_David_Lab2.Pages.BookCategoryPages.CreateModel

@{
    ViewData["Title"] = "Create BookCategory";
}

<h1>Create</h1>

<h4>BookCategory (Asociere Carte - Categorie)</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Dropdown pentru Alegerea Cartii -->
            <div class="form-group">
                <label asp-for="BookCategory.BookID" class="control-label">Book Title</label>
                <select asp-for="BookCategory.BookID" class="form-control" asp-items="ViewBag.BookID">
                    <option value="">-- Select a Book --</option>
                </select>
                <span asp-validation-for="BookCategory.BookID" class="text-danger"></span>
            </div>

            <!-- Dropdown pentru Alegerea Categoriei -->
            <div class="form-group">
                <label asp-for="BookCategory.CategoryID" class="control-label">Category Name</label>
                <select asp-for="BookCategory.CategoryID" class="form-control" asp-items="ViewBag.CategoryID">
                    <option value="">-- Select a Category --</option>
                </select>
                <span asp-validation-for="BookCategory.CategoryID" class="text-danger"></span>
            </div>

            <div class="form-group" style="margin-top: 15px;">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div style="margin-top: 15px;">
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}